{% liquid
  assign review_product = section.settings.product

  if review_product == blank and closest.product != blank
    assign review_product = closest.product
  endif

  if review_product == blank
    assign review_product = product
  endif

  case section.settings.heading_font
    when 'heading'
      assign heading_font_family = 'var(--font-heading--family)'
    when 'accent'
      assign heading_font_family = 'var(--font-accent--family)'
    else
      assign heading_font_family = 'var(--font-body--family)'
  endcase
%}

{% if review_product != blank %}
  <div class="section-background color-{{ section.settings.color_scheme }}"></div>
  <div
    class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} spacing-style"
    style="
      {% render 'spacing-padding', settings: section.settings %}
      --judgeme-heading-font-size: {{ section.settings.heading_font_size }}px;
    "
    {{ section.shopify_attributes }}
  >
    {% if section.settings.heading != blank %}
      <div
        class="judgeme-product-reviews__header judgeme-product-reviews__header--{{ section.settings.alignment }}"
      >
        <h2
          class="judgeme-product-reviews__heading"
          style="
            font-family: {{ heading_font_family }};
            font-size: {{ section.settings.heading_font_size_mobile }}px;
            line-height: {{ section.settings.heading_line_height }};
            letter-spacing: {{ section.settings.heading_letter_spacing }}em;
            text-transform: {{ section.settings.heading_text_transform }};
            font-weight: {{ section.settings.heading_font_weight }};
            color: {{ section.settings.heading_color }};
          "
        >
          {{ section.settings.heading | escape }}
        </h2>
      </div>
    {% endif %}

    <div style="clear: both;"></div>
    <div
      id="judgeme_product_reviews"
      class="jdgm-widget jdgm-review-widget judgeme-product-reviews__widget"
      data-product-title="{{ review_product.title | escape }}"
      data-id="{{ review_product.id }}"
      data-auto-install="false"
    >
      {{ review_product.metafields.judgeme.widget }}
    </div>
  </div>
{% elsif request.design_mode %}
  <div class="section-background color-{{ section.settings.color_scheme }}"></div>
  <div
    class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} spacing-style"
    style="{% render 'spacing-padding', settings: section.settings %}"
    {{ section.shopify_attributes }}
  >
    <p class="judgeme-product-reviews__placeholder">
      Select a product or use this section on a product template to show Judge.me reviews.
    </p>
  </div>
{% endif %}

{% stylesheet %}
  .judgeme-product-reviews__header {
    margin-bottom: 1.5rem;
  }

  .judgeme-product-reviews__header--left {
    text-align: left;
  }

  .judgeme-product-reviews__header--center {
    text-align: center;
  }

  .judgeme-product-reviews__header--right {
    text-align: right;
  }

  .judgeme-product-reviews__heading {
    margin: 0;
  }

  .judgeme-product-reviews__placeholder {
    margin: 0;
    opacity: 0.7;
  }

  .judgeme-product-reviews__widget,
  .judgeme-product-reviews__widget .jdgm-rev-widg,
  .judgeme-product-reviews__widget.jdgm-rev-widg {
    display: block !important;
  }

  @media screen and (min-width: 750px) {
    .judgeme-product-reviews__heading {
      font-size: var(--judgeme-heading-font-size) !important;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Judge.me product reviews",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product override"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Customer reviews"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "heading_font",
      "label": "Heading font",
      "options": [
        {
          "value": "heading",
          "label": "Heading"
        },
        {
          "value": "body",
          "label": "Body"
        },
        {
          "value": "accent",
          "label": "Accent"
        }
      ],
      "default": "heading"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "Heading font size",
      "min": 16,
      "max": 64,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "heading_font_size_mobile",
      "label": "Heading font size mobile",
      "min": 14,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "select",
      "id": "heading_line_height",
      "label": "Heading line height",
      "options": [
        {
          "value": "0.95",
          "label": "Tight"
        },
        {
          "value": "1.1",
          "label": "Normal"
        },
        {
          "value": "1.3",
          "label": "Relaxed"
        }
      ],
      "default": "1.1"
    },
    {
      "type": "range",
      "id": "heading_letter_spacing",
      "label": "Heading letter spacing",
      "min": 0,
      "max": 0.5,
      "step": 0.1,
      "unit": "em",
      "default": 0
    },
    {
      "type": "select",
      "id": "heading_text_transform",
      "label": "Heading text transform",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "uppercase",
          "label": "Uppercase"
        },
        {
          "value": "lowercase",
          "label": "Lowercase"
        },
        {
          "value": "capitalize",
          "label": "Capitalize"
        }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "heading_font_weight",
      "label": "Heading font weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semibold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "500"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#433625"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        {
          "value": "page-width",
          "label": "Page"
        },
        {
          "value": "full-width",
          "label": "Full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "Judge.me product reviews",
      "category": "Products"
    }
  ]
}
{% endschema %}
