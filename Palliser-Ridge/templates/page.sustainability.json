 our regenerative farming practises are monitored and assessed by Ata Land under the Ecological Outcome Verification programme (EOV).   <\/li><li>All our wool meets the Responsible Wool Standard. <\/li><li>We are FAP+ accredited. <\/li><li>Palliser Ridge was the Ballance Farm Environment Awards Supreme Winner for the Greater Wellington Region in 2019. <\/li><\/ul>","button_text":"","button_link":"","left_image":"shopify:\/\/shop_images\/wool-making.jpg","image_height_mode":"match","image_aspect_ratio":"square","image_object_fit":"cover","image_min_height":0,"image_max_height":1200,"column_position":"right","mobile_reverse_columns":false,"column_ratio":"equal","content_alignment":"left","vertical_alignment":"top","column_gap":40,"section_width":"page-width","heading_font":"heading","text_font":"body","heading_size_desktop":32,"subheading_size_desktop":18,"text_size_desktop":16,"heading_size_mobile":32,"subheading_size_mobile":16,"text_size_mobile":14,"column_background_color":"#ffffff","column_padding":50,"column_padding_mobile":20,"column_border_radius":8,"color_scheme":"scheme-1","image_border_radius":8,"enable_animation":true,"animation_delay":"0.2s","padding-block-start":100,"padding-block-end":25,"padding-block-start-mobile":25,"padding-block-end-mobile":25}},"section_wpGQJV":{"type":"section","blocks":{"text_VtJLcN":{"type":"text","name":"t:names.heading","settings":{"text":"<h3>Our Environmental Vision is to leave the land we farm and the water courses that run through it, enriched.<\/h3>","width":"fit-content","max_width":"normal","alignment":"left","type_preset":"custom","font":"var(--font-body--family)","font_size":"2rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"var(--color-foreground)","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}}},"block_order":["text_VtJLcN"],"name":"Our Environme