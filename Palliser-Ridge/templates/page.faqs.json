"#00000066","overlay_style":"solid","gradient_direction":"to top","blurred_reflection":false,"reflection_opacity":75,"padding-block-start":40,"padding-block-end":40}},"section_PqCj4H":{"type":"section","blocks":{"text_NwmzBn":{"type":"text","name":"t:names.heading","settings":{"text":"<h2>Frequently Asked Questions<\/h2>","width":"fit-content","max_width":"none","alignment":"left","type_preset":"h3","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"var(--color-foreground)","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}}},"block_order":["text_NwmzBn"],"name":"FAQ's heading","settings":{"content_direction":"column","vertical_on_mobile":true,"horizontal_alignment":"flex-start","vertical_alignment":"center","align_baseline":false,"horizontal_alignment_flex_direction_column":"center","vertical_alignment_flex_direction_column":"center","gap":12,"section_width":"page-width","section_height":"custom","section_height_custom":0,"color_scheme":"","background_media":"none","video_position":"cover","background_image_position":"cover","border":"none","border_width":1,"border_opacity":100,"border_radius":0,"toggle_overlay":false,"overlay_color":"#00000026","overlay_style":"solid","gradient_direction":"to top","padding-block-start":100,"padding-block-end":0}},"section_QYKW98":{"type":"section","blocks":{"accordion_6iBRNx":{"type":"accordion","name":"t:names.accordion","settings":{"icon":"plus","dividers":true,"type_preset":"h5","inherit_color_scheme":true,"color_scheme":"","border":"none","border_width":1,"border_opacity":100,"border_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{"accordion_row_HEDEJJ":{"type":"_accordion-row","settings":{"heading":"Where are your lambswool throw blankets made?","open_by_default":false,"icon":"none","width":20},"blocks":{"text_xKxWbF":{"type":"text","settings":{"text":"<p>All our luxury lambswool throw blankets are 100% made in New Zealand. Our wool is from the lambs grown on our South Wairarapa farm, with the highest standards of sustainability and animal welfare. Once the wool has been scoured by Woolworksin Napier, it is spun into yarn by Woolyarnsin Lower Hutt and then woven by Inter-weave Limited in Auckland. We are proud to support other New Zealand businesses in our value chain.<\/p>","width":"100%","max_width":"none","alignment":"left","type_preset":"rte","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"var(--color-foreground)","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}}},"block_order":["text_xKxWbF"]},"accordion_row_JFhnQ7":{"type":"_accordion-row","settings":{"heading":"Is Palliser Ridge a working farm?","open_by_default":false,"icon":"none","width":20},"blocks":{"text_EGBtGB":{"type":"text","settings":{"text":"<p>Yes, we are fully integrated sheep,beefand organic dairy farm in the South Wairarapa. We farm to the highest ethical and sustainable standards, with a commitment to regenerative farm practises that are verified by Ata Land. Our wool products also meet the globally recognised Responsible Wool Standard. As a family farm we are proud to provide our high quality natural wool products from our land to families all over New Zealand and beyond.<\/p>","width":"100%","max_width":"none","alignment":"left","type_preset":"rte","font":"var(--font-body--family)","font_size":"1.125rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"var(--color-foreground)","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}}},"block_order":["text_EGBtGB"]},"accordion_row_q86AJF":{"type":"_accordion-row","name":"t:names.accordion_row","settings":{"heading":"How do I care for my lambswool throw blanket?","open_by_default":false,"icon":"none","width":20},"blocks":{"text_p9Gf6f":{"type":"text","name":"t:names.text","settings":{"text":"<p>We recommend dry cleaning your throws if needed, or small spot cleaning should accidents occur. As a natural fibre wool has natural oils that help it to repel dirt and dust, providing a healthy and durableoptionfor your home.<\/p>","width":"100%","max_width":"none","alignment":"left","type_preset":"rte","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"var(--color-foreground)","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}}},"block_order":["text_p9Gf6f"]},"accordion_row_WUnqD3":{"type":"_accordion-row","name":"t:names.accordion_row","settings":{"heading":"Why should I buy a wool product?","open_by_default":false,"icon":"none","width":20},"blocks":{"text_wGWzmH":{"type":"text","name":"t:names.text","settings":{"text":"<p>Wool is a naturally renewable fibre with many benefits for warmth, durability and breathability. Its also fully biodegradable unlike synthetic textiles.<\/p>","width":"100%","max_width":"none","alignment":"left","type_preset":"rte","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"var(--color-foreground)","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}}},"block_order":["text_wGWzmH"]},"accordion_row_aUqT6b":{"type":"_accordion-row","name":"t:names.accordion_row","settings":{"heading":"How can I use your yarn?","open_by_default":false,"icon":"none","width":20},"blocks":{"text_kX3R7U":{"type":"text","name":"t:names.text","settings":{"text":"<p>Our knitting yarn is 8 ply and excellent for all your knitting projects including appareland homewares. Customers report it also works well for machine knitting. We have four colours currently available in either 1.1 kilogramme cones or 100 gramballs.<\/p>","width":"100%","max_width":"none","alignment":"left","type_preset":"rte","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"var(--color-foreground)","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}}},"block_order":["text_kX3R7U"]},"accordion_row_bxazDi":{"type":"_accordion-row","name":"t:names.accordion_row","settings":{"heading":"Do you provide gift options?","open_by_default":false,"icon":"none","width":20},"blocks":{"text_iBWTXA":{"type":"text","name":"t:names.text","settings":{"text":"<p>Our luxury throw blankets and baby blankets are an ideal gift for a special occasion. Throws can come in a beautiful gift box and can be sent directly to the person you are celebrating. <\/p><p>If you have left it too late , or aren’t sure what throw blanket they would like best, we can also provide you with a gift voucher that they redeem at their leisure for the colour and design of their choice. <\/p>","width":"100%","max_width":"none","alignment":"left","type_preset":"rte","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"var(--color-foreground)","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}}},"block_order":["text_iBWTXA"]},"accordion_row_W7mbP3":{"type":"_accordion-row","name":"t:names.accordion_row","settings":{"heading":"How sustainable are your products?","open_by_default":false,"icon":"none","width":20},"blocks":{"text_xAhPtd":{"type":"text","name":"t:names.text","settings":{"text":"<p>Our products are sustainably and ethically 100% kiwi made. Our farm is FAP+ accredited and all our wool is fully traceable and meets the globally recognised Responsible Wool Standard.  <\/p><p>Palliser Ridge has also been Land to Market accredited since 2021; our regenerative farming practises are monitored and assessed by Ata Land under the Ecological Outcome Verification programme (EOV).   <\/p><p>Our efforts were recognsied in 2019 when Palliser Ridge was the Ballance Farm Environment Awards Supreme Winner for the Greater Wellington Region. <\/p><p>We continue our commitment to annual tree planting, protection of remnant native bush areas, wetland restorations and contribution to regional biodiversity corridors. <\/p>","width":"100%","max_width":"none","alignment":"left","type_preset":"rte","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"var(--color-foreground)","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}}},"block_order":["text_xAhPtd"]},"accordion_row_BDB6UR":{"type":"_accordion-row","name":"t:names.accordion_row","settings":{"heading":"Can I visit your farm?","open_by_default":false,"icon":"none","width":20},"blocks":{"text_AidYHG":{"type":"text","name":"t:names.text","settings":{"text":"<p>Visits are by appointment only. Please get in touch if you are a group that wishes to organise a visit to Palliser Ridge farm. Contact us on : <a href=\"tel:+64 277667259\" title=\"tel:+64 277667259\">+64 27 766 7259<\/a><\/p>","width":"100%","max_width":"none","alignment":"left","type_preset":"rte","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"var(--color-foreground)","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}}},"block_order":["text_AidYHG"]},"accordion_row_XTarPP":{"type":"_accordion-row","name":"t:names.accordion_row","settings":{"heading":"Do you ship worldwide?","open_by_default":false,"icon":"none","width":20},"blocks":{"text_KTdMWc":{"type":"text","name":"t:names.text","settings":{"text":"<p>We are able to ship our products to any customers in New Zealand and Australia. There is free shipping on our Lambswool throw blankets anywhere in New Zealand.<\/p>","width":"100%","max_width":"none","alignment":"left","type_preset":"rte","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"var(--color-foreground)","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}}},"block_order":["text_KTdMWc"]},"accordion_row_eEWRwc":{"type":"_accordion-row","name":"t:names.accordion_row","settings":{"heading":"Do you provide products for corporate gifts?","open_by_default":false,"icon":"none","width":20},"blocks":{"text_PLTKFP":{"type":"text","name":"t:names.text","settings":{"text":"<p>Yes, we work with many companies across New Zealand to supply high quality luxury Lambswool throw blankets, including baby blankets. We can provide bespoke labelling and are happy to talk to you about other ways we can support companies wishing to gift 100% New Zealand made, direct from the farm, luxury products.<\/p>","width":"100%","max_width":"none","alignment":"left","type_preset":"rte","font":"var(--font-body--family)","fon